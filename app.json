{
  "expo": {
    "name": "Salah",
    "slug": "salah-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.salah"
    },
    "android": {
      "package": "com.example.salah",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Salah uses your location to calculate accurate prayer times."
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "eas": {
        "projectId": "847ea704-ae2f-4b71-875d-51082382f8c4"
      }
    },
    "owner": "ujjval.shh"
  }
}
